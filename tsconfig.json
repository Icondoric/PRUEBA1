{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node", "vitest/globals", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["src/web/**"]
}
